# PostgreSQL only. Local development uses the local server on port 5432.
DATABASE_URL=postgresql+psycopg://shanhe_app:change-me@127.0.0.1:5432/shanhe
AUTH_SESSION_TTL_HOURS=12

# Server-only URL used by the Next.js BFF. Never rename this to NEXT_PUBLIC_*.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Server-only Ccode model provider configuration. Never expose these as NEXT_PUBLIC_*.
CCODE_API_BASE_URL=https://api.ccode.vip
CCODE_API_KEY=
# Required comma-separated server-only allowlist of model IDs exposed through the authenticated BFF.
CCODE_ALLOWED_MODELS=replace-with-model-id
CCODE_REQUEST_TIMEOUT_SECONDS=90
CCODE_MAX_OUTPUT_TOKENS=4096

# Server-only Volcengine Doubao Search Global API configuration.
# The API key must never use a NEXT_PUBLIC_* name.
VOLCENGINE_SEARCH_API_KEY=
VOLCENGINE_SEARCH_TIMEOUT_SECONDS=15
VOLCENGINE_SEARCH_DOC_COUNT=10
VOLCENGINE_SEARCH_MAX_SNIPPET_LENGTH=1000
VOLCENGINE_SEARCH_ICP_HOST_ONLY=false
